Algoritmo "numero-positivo"
// Aula 05 - Ex13 - Numero Positivo
// O REPITA so solta o programa quando o numero for positivo de verdade, sem gambiarra.

Var
   numero: inteiro

Inicio
   Repita
      escreva("Digite um numero maior que zero: ")
      leia(numero)
   Ate numero > 0

   escreval("Numero digitado: ", numero)
Fimalgoritmo
