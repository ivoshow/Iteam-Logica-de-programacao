Algoritmo "contagem-regressiva"
// Aula 05 - Ex06 - Contagem Regressiva
// Sem foguete, sem confete, so o ENQUANTO contando ate estourar o Ano Novo.

Var
   i: inteiro

Inicio
// contagem regressiva de 10 ate 1
   i <- 10
   Enquanto i >= 1 faca
      escreval(i)
      i <- i - 1
   fimenquanto
// e quando acabar a contagem, a gente comemora o Ano Novo kkk
   escreval("Feliz Ano Novo!")
Fimalgoritmo
