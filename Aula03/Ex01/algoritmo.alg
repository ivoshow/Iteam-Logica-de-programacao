Algoritmo "antecessor-e-sucessor"
// Aula 03 - Ex01 - Antecessor e Sucessor
// Ideia: dado um numero, o antecessor e ele menos 1 e o sucessor e ele mais 1.

Var
   // numero que a pessoa vai informar
   numero: inteiro

Inicio
   // peco o numero inteiro
   escreva("Digite um numero inteiro: ")
   leia(numero)

   // faco as contas direto na hora de mostrar
   escreval("Antecessor: ", numero - 1)
   escreval("Sucessor:   ", numero + 1)
Fimalgoritmo
