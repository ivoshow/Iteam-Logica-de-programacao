Algoritmo "boas-vindas"
// Aula 02 - Ex02 - Boas-vindas
// Ideia: perguntar o nome da pessoa e cumprimentar ela pelo nome.

Var
   // guardo aqui o nome que a pessoa vai digitar
   nome: caractere

Inicio
   // primeiro peco o nome
   escreva("Digite seu nome: ")
   leia(nome)

   // agora devolvo a saudacao ja usando o nome que recebi
   escreval("Ola, ", nome, "! Bem-vindo(a) ao mundo da programacao na Iteam.")
Fimalgoritmo
